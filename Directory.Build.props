<Project>

  <!--
    全局 MSBuild 属性。
    版本号唯一来源是仓库根目录的 VERSION 文件，避免多处不同步。
  -->
  <PropertyGroup>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
    <Product>Coloring Voxels Tool</Product>
    <Company>Coloring Voxels Tool contributors</Company>
    <Authors>Coloring Voxels Tool contributors</Authors>
    <Copyright>MIT License</Copyright>
    <RepositoryUrl>https://github.com/dark-but-spark/ColoringVixels-Tool</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
